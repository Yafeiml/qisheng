# Generate with: node deploy/self-host.mjs init
QISHENG_VERSION=local
# managed: installation owns PostgreSQL/Redis; external: use existing services.
COMPOSE_PROFILES=
QISHENG_DATABASE_MODE=managed
QISHENG_DATA_DIR=./data
POSTGRES_USER=qisheng
POSTGRES_DB=qisheng
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
REDIS_PASSWORD=GENERATE_REDIS_PASSWORD
INSTALLATION_TOKEN=GENERATE_INSTALLATION_TOKEN
NEXT_PUBLIC_API_BASE_URL=/api
INTERNAL_API_BASE_URL=http://api:3100
ADMIN_WEB_ORIGIN=http://localhost:3101
# This is only the legacy direct-API CORS fallback; Docker Web uses same-origin /api.
WEB_BIND_PORT=3101
NODE_ENV=production
ENABLE_DEV_AUTH=false
GENERATION_DELIVERY_MODE=PRODUCTION
GENERATION_EXECUTION_MODE=queue
MATERIAL_INGESTION_EXECUTION_MODE=queue
MVP_GENERATION_ADAPTER=openai-compatible
API_HOST=0.0.0.0
API_PORT=3100
TRUST_PROXY_HOPS=0
DATABASE_URL=GENERATE_DATABASE_URL
REDIS_URL=GENERATE_REDIS_URL
REDIS_PREFIX=qisheng:selfhost
MODEL_CREDENTIAL_ENCRYPTION_KEY=GENERATE_MODEL_KEY
MODEL_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
JWT_ISSUER=xhs-agentic-api
ADMIN_JWT_SECRET=GENERATE_ADMIN_JWT
EMPLOYEE_JWT_SECRET=GENERATE_EMPLOYEE_JWT
ADMIN_OTP_HMAC_SECRET=GENERATE_ADMIN_OTP
EMPLOYEE_OTP_HMAC_SECRET=GENERATE_EMPLOYEE_OTP
ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_SECONDS=2592000
# New installations persist LOCAL; unset preserves existing storage choices and legacy S3 fallback.
OBJECT_STORAGE_PROVIDER=
# Docker fixes this container path; QISHENG_DATA_DIR selects the host's persistent directory.
OBJECT_STORAGE_LOCAL_ROOT=/var/lib/qisheng/storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
ASSET_DELIVERY_MODE=S3_SIGNED
PUBLICATION_READBACK_ENABLED=false
LIFECYCLE_INTERVAL_MS=30000
GENERATION_WORKER_CONCURRENCY=4
GENERATION_WORKER_RATE_LIMIT=10
