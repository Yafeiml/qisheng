generator client {
  provider = "prisma-client-js"
}

// Platform-only experiments. No campaign, task or business storage mutations.
model GenerationLabRun {
  id           String               @id @default(cuid())
  createdBy    String               @map("created_by")
  tenantId     String               @map("tenant_id")
  enterpriseId String               @map("enterprise_id")
  parentId     String?              @map("parent_id")
  title        String
  action       String               @default("COPY")
  status       String               @default("DRAFT")
  input        Json
  result       Json?
  error        String?
  reviewStatus String               @default("NONE") @map("review_status")
  review       Json?
  leaseToken   String?              @map("lease_token")
  heartbeatAt  DateTime?            @map("heartbeat_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  assets       GenerationLabAsset[]
  calls        GenerationLabCall[]

  @@index([status, createdAt])
  @@index([reviewStatus, createdAt])
  @@index([enterpriseId, createdAt])
  @@map("generation_lab_runs")
}

model GenerationLabAsset {
  id          String           @id @default(cuid())
  runId       String           @map("run_id")
  run         GenerationLabRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind        String
  description String
  mimeType    String           @map("mime_type")
  checksum    String
  bytes       Bytes
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([runId, kind])
  @@map("generation_lab_assets")
}

model GenerationLabCall {
  id         String           @id @default(cuid())
  runId      String           @map("run_id")
  run        GenerationLabRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind       String
  providerId String           @map("provider_id")
  modelId    String           @map("model_id")
  request    Json
  status     String           @default("STARTED")
  usage      Json?
  error      String?
  latencyMs  Int?             @map("latency_ms")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([runId, createdAt])
  @@map("generation_lab_calls")
}

