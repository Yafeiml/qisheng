  directoryMemberLinks      DirectoryMemberLink[]
  directorySyncRuns         DirectorySyncRun[]
  directorySyncChanges      DirectorySyncChange[]
  directoryEventInbox       DirectoryEventInbox[]
  directoryAlerts           DirectoryAlert[]
  roleBindings              RoleBinding[]
  adminOrganizationProfiles AdminOrganizationProfile[]
  auditLogs                 AuditLog[]
  materials                 Material[]
  materialArtifacts         MaterialArtifact[]
  materialIngestionJobs     MaterialIngestionJob[]
  materialChunks            MaterialChunk[]
  materialEmbeddings        MaterialEmbedding[]
  campaignRetrievalEvidence CampaignRetrievalEvidence[]
  sensitiveRules            SensitiveRule[]
  geoEntities               GeoEntity[]
  geoTopics                 GeoTopic[]
  campaigns                 Campaign[]
  promptTemplates           PromptTemplate[]
  campaignTemplates         CampaignTemplate[]
  campaignDrafts            CampaignDraft[]
  managementActions         ManagementAction[]
  campaignAudienceSnapshots CampaignAudienceSnapshot[]
  generationWorkItems       GenerationWorkItem[]
  modelInvocations          ModelInvocation[]
  employeeContents          EmployeeContent[]
  distributionTasks         DistributionTask[]
  modelRoutes               ModelRoute[]
  employeeContentRevisions  EmployeeContentRevision[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "enterprises_name_trgm_idx")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "enterprises_code_trgm_idx")
  @@map("enterprises")
}

model AdminUser {
  id                         String           @id @default(cuid())
  name                       String?          @db.VarChar(100)
  phone                      String?          @unique @db.VarChar(32)
  username                   String?          @unique @db.VarChar(64)
  passwordHash               String?          @map("password_hash") @db.VarChar(256)
  employeeUserId             String?          @unique @map("employee_user_id")
  email                      String?          @unique @db.VarChar(254)
  emailVerifiedAt            DateTime?        @map("email_verified_at")
  emailVerificationTokenHash String?          @unique @map("email_verification_token_hash") @db.VarChar(64)
  emailVerificationExpiresAt DateTime?        @map("email_verification_expires_at")
  avatarUrl                  String?          @map("avatar_url") @db.VarChar(1000)
  phoneVerifiedAt            DateTime?        @map("phone_verified_at")
  status                     GlobalUserStatus @default(ACTIVE)
  lastLoginAt                DateTime?        @map("last_login_at")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  roleBindings         RoleBinding[]
  adminSessions        AdminSession[]
  organizationProfiles AdminOrganizationProfile[]
  employeeUser         GlobalUser?                @relation(fields: [employeeUserId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([name])
  @@map("admin_users")
}

model AdminOrganizationProfile {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  scopeType    AccessScopeType @map("scope_type")
  scopeId      String          @map("scope_id") @db.VarChar(64)
  tenantId     String?         @map("tenant_id")
  enterpriseId String?         @map("enterprise_id")
  jobTitle     String?         @map("job_title") @db.VarChar(100)
  department   String?         @db.VarChar(100)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  user       AdminUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enterprise Enterprise? @relation(fields: [enterpriseId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([userId, scopeType, scopeId])
  @@index([tenantId, userId])
  @@index([enterpriseId, userId])
  @@index([scopeType, scopeId])
  @@map("admin_organization_profiles")
}

