// Durable outbox: a browser collector may read only a due leased job. The
// submission remains the source of truth for the employee's submission time.
model PublicationCollectionJob {
  id             String    @id @default(cuid())
  submissionId   String    @map("submission_id")
  kind           String    @db.VarChar(16)
  windowHours    Int       @default(0) @map("window_hours")
  status         String    @default("QUEUED") @db.VarChar(24)
  dueAt          DateTime  @map("due_at")
  attempts       Int       @default(0)
  leaseOwner     String?   @map("lease_owner") @db.VarChar(80)
  leaseToken     String?   @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at")
  heartbeatAt    DateTime? @map("heartbeat_at")
  observedAt     DateTime? @map("observed_at")
  evidence       Json?
  errorCode      String?   @map("error_code") @db.VarChar(80)
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
