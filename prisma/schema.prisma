  @@unique([submissionId, kind, windowHours])
  @@index([status, dueAt, id])
  @@index([submissionId, status])
  @@index([kind, updatedAt(sort: Desc), id(sort: Desc)], map: "publication_collection_jobs_kind_updated_at_id_idx")
  @@map("publication_collection_jobs")
}

