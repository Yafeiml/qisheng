model Tenant {
  id           String             @id @default(cuid())
  name         String             @db.VarChar(160)
  customerType TenantCustomerType @map("customer_type")
  status       TenantStatus       @default(ACTIVE)
  timezone     String             @default("Asia/Shanghai") @db.VarChar(64)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  enterprises                 Enterprise[]
  memberships                 EnterpriseMembership[]
  roleBindings                RoleBinding[]
  adminOrganizationProfiles   AdminOrganizationProfile[]
  auditLogs                   AuditLog[]
  customerContracts           CustomerContract[]
  departments                 Department[]
  membershipImportBatches     MembershipImportBatch[]
  enterprisePersonnelPolicies EnterprisePersonnelPolicy[]
  membershipParticipations    MembershipParticipation[]
  directoryConnections        DirectoryConnection[]
  directoryEnterpriseMappings DirectoryEnterpriseMapping[]
  directoryDepartmentLinks    DirectoryDepartmentLink[]
  directoryMemberLinks        DirectoryMemberLink[]
  directorySyncRuns           DirectorySyncRun[]
  directorySyncChanges        DirectorySyncChange[]
  directoryEventInbox         DirectoryEventInbox[]
  directoryAlerts             DirectoryAlert[]
  materials                   Material[]
  materialArtifacts           MaterialArtifact[]
  materialIngestionJobs       MaterialIngestionJob[]
  materialChunks              MaterialChunk[]
  materialEmbeddings          MaterialEmbedding[]
  campaignRetrievalEvidence   CampaignRetrievalEvidence[]
  sensitiveRules              SensitiveRule[]
  geoEntities                 GeoEntity[]
  geoTopics                   GeoTopic[]
  campaigns                   Campaign[]
  promptTemplates             PromptTemplate[]
  campaignTemplates           CampaignTemplate[]
  campaignDrafts              CampaignDraft[]
  managementActions           ManagementAction[]
  campaignAudienceSnapshots   CampaignAudienceSnapshot[]
  campaignBlueprints          CampaignBlueprint[]
  generationRuns              GenerationRun[]
  generationWorkItems         GenerationWorkItem[]
  modelInvocations            ModelInvocation[]
  employeeContents            EmployeeContent[]
  generatedImages             GeneratedImage[]
  distributionTasks           DistributionTask[]
  publishSubmissions          PublishSubmission[]
  publishedContentRegistry    PublishedContentRegistry[]
  publicContentFixtures       PublicContentFixture[]
  publishMetricSnapshots      PublishMetricSnapshot[]
  modelRoutes                 ModelRoute[]
  platformCustomerNotes       PlatformCustomerNote[]
  employeeContentRevisions    EmployeeContentRevision[]
  storageAccount              TenantStorageAccount?
  capabilityPolicy            TenantCapabilityPolicy?

  @@index([status])
  @@index([createdAt, id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "tenants_name_trgm_idx")
  @@map("tenants")
}

model TenantCapabilityPolicy {
  tenantId                    String   @id @map("tenant_id")
  maxEnterprises              Int?     @map("max_enterprises")
  maxImagesPerContent         Int      @default(1) @map("max_images_per_content")
  groupSharedMaterialsEnabled Boolean  @default(true) @map("group_shared_materials_enabled")
  geoEnabled                  Boolean  @default(true) @map("geo_enabled")
  geoEntityLimit              Int      @default(500) @map("geo_entity_limit")
  geoTopicLimit               Int      @default(5000) @map("geo_topic_limit")
  metricsIntegrationEnabled   Boolean  @default(true) @map("metrics_integration_enabled")
  storageLimitBytes           BigInt   @default(10737418240) @map("storage_limit_bytes")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_capability_policies")
}

