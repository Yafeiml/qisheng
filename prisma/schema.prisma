model EmployeeTaskNotification {
  id                                  String    @id @default(cuid())
  taskId                              String    @map("task_id")
  event                               String    @default("NEW_TASK") @db.VarChar(32)
  userId                              String    @map("user_id")
  appId                               String    @map("app_id") @db.VarChar(32)
  templateId                          String    @map("template_id") @db.VarChar(160)
  identityId                          String?   @map("identity_id")
  subscriptionId                      String?   @map("subscription_id")
  identityVersion                     Int       @default(1) @map("identity_version")
  status                              String    @default("PENDING") @db.VarChar(20)
  attempts                            Int       @default(0)
  nextAttemptAt                       DateTime  @default(now()) @map("next_attempt_at")
  leaseToken                          String?   @map("lease_token") @db.VarChar(64)
  leaseUntil                          DateTime? @map("lease_until")
  errorCode                           String?   @map("error_code") @db.VarChar(120)
  subscriptionReserved                Boolean   @default(false) @map("subscription_reserved")
  subscriptionAuthorizationGeneration Int?      @map("subscription_authorization_generation")
  channel                             String    @default("WECHAT_TEMPLATE") @db.VarChar(32)
  recipientPhone                      String?   @map("recipient_phone") @db.VarChar(32)
  recipientPhoneVerifiedAt            DateTime? @map("recipient_phone_verified_at")
  recipientPhoneVersion               Int?      @map("recipient_phone_version")
  smsBizId                            String?   @map("sms_biz_id") @db.VarChar(160)
  smsProviderRequestId                String?   @map("sms_provider_request_id") @db.VarChar(160)
  smsDeliveryStatus                   String?   @map("sms_delivery_status") @db.VarChar(20)
  smsDeliveryCode                     String?   @map("sms_delivery_code") @db.VarChar(120)
  smsDeliveredAt                      DateTime? @map("sms_delivered_at")
  smsQueryAttempts                    Int       @default(0) @map("sms_query_attempts")
  smsNextQueryAt                      DateTime? @map("sms_next_query_at")
  lastAttemptAt                       DateTime? @map("last_attempt_at")
  sentAt                              DateTime? @map("sent_at")
  createdAt                           DateTime  @default(now()) @map("created_at")
  updatedAt                           DateTime  @updatedAt @map("updated_at")

  task         DistributionTask                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
