<view class="page-shell login-page">
  <view class="login-hero">
    <view class="hero-title">每一次发布，都是你的专属内容</view>
    <view class="hero-copy">使用管理员创建的员工账号登录，仅可查看本人的任务、发布历史与公开指标。</view>
    <view class="hero-stickers">
      <text>一人一图</text>
      <text>24h 有效</text>
      <text>多企业</text>
    </view>
  </view>

  <view class="surface login-card">
    <block wx:if="{{authMode === 'PASSWORD'}}">
      <view class="card-heading">
        <text class="eyebrow">企声发布 · 员工端</text>
        <view>账号密码登录</view>
        <text>没有账号或无法登录？请联系企业管理员创建账号或重置密码。</text>
      </view>
      <label>
        <text class="field-label">账号</text>
        <input class="text-field" type="text" maxlength="64" value="{{username}}" bindinput="onUsernameInput" disabled="{{busy}}" placeholder="请输入管理员创建的账号" />
      </label>
      <label>
        <text class="field-label">密码</text>
        <input class="text-field" type="text" password="{{true}}" maxlength="128" value="{{password}}" bindinput="onPasswordInput" bindconfirm="loginPassword" confirm-type="go" disabled="{{busy}}" placeholder="请输入账号密码" />
      </label>
      <button class="primary-button" hover-class="button-hover" loading="{{busy}}" disabled="{{busy}}" bindtap="loginPassword">{{securityProgress >= 0 ? '安全验证中 ' + securityProgress + '%' : busy ? '正在登录…' : '登录'}}</button>
      <button wx:if="{{smsLoginEnabled}}" class="link-button" hover-class="button-hover" disabled="{{busy}}" bindtap="useSmsLogin">使用短信验证码登录</button>
    </block>

    <block wx:else>
    <view class="step-row">
      <view class="step {{stage === 'PHONE' ? 'active' : 'done'}}"><text>1</text>手机号</view>
      <view class="step-line"></view>
      <view class="step {{stage === 'CODE' ? 'active' : (stage === 'SELECT' ? 'done' : '')}}"><text>2</text>验证</view>
      <view class="step-line"></view>
      <view class="step {{stage === 'SELECT' ? 'active' : ''}}"><text>3</text>企业</view>
    </view>

    <block wx:if="{{stage === 'PHONE'}}">
      <view class="card-heading">
        <text class="eyebrow">员工任务登录</text>
        <view>{{joinMode ? '加入其他企业' : '登录员工身份'}}</view>
        <text>手机号须已由企业管理员导入并启用任务资格。</text>
      </view>
      <label>
        <text class="field-label">手机号码</text>
        <input class="text-field" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" disabled="{{busy}}" placeholder="请输入 11 位手机号" />
      </label>
      <button class="primary-button" hover-class="button-hover" loading="{{busy}}" disabled="{{busy || retryRemaining > 0}}" bindtap="requestCode">{{securityProgress >= 0 ? '安全验证中 ' + securityProgress + '%' : retryRemaining > 0 ? retryRemaining + ' 秒后重发' : '发送短信验证码'}}</button>
    </block>

    <block wx:elif="{{stage === 'CODE'}}">
      <view class="card-heading">
        <text class="eyebrow">验证手机号</text>
        <view>验证 {{phoneMasked}}</view>
        <text>验证码有效期为 5 分钟；已绑定员工验证后直接登录，首次加入时再选择企业。</text>
      </view>
      <label>
        <text class="field-label">六位验证码</text>
        <input class="text-field code-field" type="number" maxlength="6" value="{{code}}" bindinput="onCodeInput" disabled="{{busy}}" placeholder="短信验证码" focus />
      </label>
      <view wx:if="{{developmentCode}}" class="development-code">
        <text>临时调试验证码</text>
        <text class="development-code-value">{{developmentCode}}</text>
        <view>仅用于已授权的限时联调，不会发送真实短信。</view>
      </view>
      <button class="primary-button" hover-class="button-hover" loading="{{busy}}" disabled="{{busy}}" bindtap="loadCandidates">验证并继续</button>
      <button class="link-button" hover-class="button-hover" disabled="{{busy || retryRemaining > 0}}" bindtap="requestCode">{{securityProgress >= 0 ? '安全验证中 ' + securityProgress + '%' : retryRemaining > 0 ? retryRemaining + ' 秒后重发' : '重新获取验证码'}}</button>
      <button class="link-button" hover-class="button-hover" disabled="{{busy}}" bindtap="backToPhone">更换手机号</button>
    </block>

    <block wx:else>
      <view class="card-heading">
        <text class="eyebrow">CHOOSE ENTERPRISES</text>
        <view>选择要加入的企业</view>
        <text>同一手机号可多选；在不同企业会分别收到独立图文。</text>
      </view>
      <view class="candidate-list">
        <view wx:for="{{candidates}}" wx:key="enterpriseId" class="candidate {{item.selected ? 'selected' : ''}} {{busy ? 'disabled' : ''}}" data-enterprise-id="{{item.enterpriseId}}" bindtap="toggleCandidate" role="checkbox" aria-checked="{{item.selected}}" aria-disabled="{{busy}}">
          <view class="candidate-check">{{item.selected ? '✓' : ''}}</view>
          <view class="candidate-main">
            <text class="candidate-title">{{item.tenantName}}·{{item.enterpriseName}}</text>
            <text class="candidate-meta">{{item.departmentName ? item.departmentName + ' ' : ''}}{{item.employeeName}}</text>
          </view>
        </view>
      </view>
      <button class="primary-button" hover-class="button-hover" loading="{{busy}}" disabled="{{busy || selectedCount === 0}}" bindtap="bindSelected">确认加入 {{selectedCount}} 家企业</button>
      <button class="link-button" hover-class="button-hover" disabled="{{busy}}" bindtap="backToPhone">重新验证</button>
    </block>

    <button class="link-button" hover-class="button-hover" disabled="{{busy}}" bindtap="usePasswordLogin">使用账号密码登录</button>
    </block>

    <view wx:if="{{error}}" class="message error">{{error}}</view>
    <view wx:if="{{notice}}" class="message success">{{notice}}</view>
  </view>

  <view class="privacy-note">继续操作即表示你同意企业向本人分发已审核素材。企业安排发布条件，你只需确认内容真实、手动发布并回填。</view>
</view>
