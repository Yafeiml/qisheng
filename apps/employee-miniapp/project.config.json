{
  "appid": "touristappid",
  "compileType": "miniprogram",
  "description": "企声共创员工端",
  "libVersion": "3.7.12",
  "miniprogramRoot": "./",
  "packOptions": {
    "ignore": [
      {
        "value": "node_modules",
        "type": "folder"
      },
      {
        "value": "package.json",
        "type": "file"
      },
      {
        "value": "README.md",
        "type": "file"
      },
      {
        "value": "tsconfig.json",
        "type": "file"
      }
    ],
    "include": []
  },
  "projectname": "xhs-agentic-employee-miniapp",
  "setting": {
    "compileHotReLoad": true,
    "es6": true,
    "minified": true,
    "postcss": true,
    "urlCheck": true,
    "useCompilerPlugins": ["typescript"],
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "enhance": false,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "condition": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "simulatorPluginLibVersion": {},
  "editorSetting": {}
}
