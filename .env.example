NODE_ENV=development
# debug / info / warn / error / silent
LOG_LEVEL=info
API_PORT=3100
API_HOST=127.0.0.1
ADMIN_WEB_ORIGIN=http://127.0.0.1:3101,http://localhost:3101
# API 请求体上限和反向代理跳数。只有部署在可信代理之后时才增加 TRUST_PROXY_HOPS。
API_BODY_LIMIT_BYTES=102400
TRUST_PROXY_HOPS=0
# 正式账号密码登录不依赖短信。CAP 默认关闭。
# 在「平台后台 → 参数中心 → 安全设置」填写自己的 Cap Endpoint 与 Secret Key 后可启用。
# 后台配置优先且立即生效；以下环境变量保留为兼容回退，Secret 仅由服务端使用。
SMS_CAP_ENDPOINT=
SMS_CAP_SECRET=
# 单项 Readiness 检查的最大等待时间。
READINESS_TIMEOUT_MS=3000
# Redis 分布式限流；认证限制窗口为 10 分钟，其余窗口为 1 分钟。
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_IP_MAX=60
RATE_LIMIT_AUTH_SUBJECT_MAX=10
# 只在 ENABLE_DEV_AUTH 生效的本机初始化接口使用独立的一分钟限制。
RATE_LIMIT_DEV_AUTH_MAX=600
RATE_LIMIT_EXPENSIVE_MAX=30
RATE_LIMIT_INTEGRATION_MAX=120
RATE_LIMIT_REDIS_TIMEOUT_MS=1000
JWT_ISSUER=xhs-agentic-api
ADMIN_JWT_SECRET=dev-only-admin-secret-replace-before-production-2026
EMPLOYEE_JWT_SECRET=dev-only-employee-secret-replace-before-production-2026
ADMIN_OTP_HMAC_SECRET=dev-only-admin-otp-hmac-secret-replace-before-production-2026
EMPLOYEE_OTP_HMAC_SECRET=dev-only-otp-hmac-secret-replace-before-production-2026
ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_SECONDS=2592000
# 阿里云短信四项配置；也可在后台“安全设置 → 管理员短信登录”保存。
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 保存后台配置后自动启用 ALIYUN；以下参数保留兼容旧部署。
ADMIN_SMS_MODE=DEVELOPMENT
ADMIN_SMS_PROVIDER=
ADMIN_SMS_ENDPOINT=
ADMIN_SMS_API_KEY=
ADMIN_SMS_SENDER=
ADMIN_SMS_TEMPLATE_ID=
ADMIN_SMS_TIMEOUT_MS=10000
ENABLE_DEV_AUTH=true
# 员工小程序调试验证码的四项配置在平台管理后台「参数设置 → 小程序设置」中管理。
DEV_PLATFORM_ADMIN_PHONE=13800000000
MVP_GENERATION_ADAPTER=synthetic
GENERATION_EXECUTION_MODE=queue
# DEVELOPMENT 允许显式 synthetic 演示；PRODUCTION 对 API 与 Worker 同时启用真实交付硬门禁。
# 未配置时 NODE_ENV=production 自动视为 PRODUCTION，其余环境视为 DEVELOPMENT。
GENERATION_DELIVERY_MODE=DEVELOPMENT
HERMES_INGEST_KEY=dev-hermes-ingest-key-replace-before-production
LIFECYCLE_INTERVAL_MS=30000
GENERATION_WORKER_CONCURRENCY=4
# 分布式笔记回读默认关闭；启用前需部署采集节点并做真实样本验收。
PUBLICATION_READBACK_ENABLED=false
# 原子领取时的 UTC 单日最大预算次数；45 token/次，建议按供应商套餐调整。
PUBLICATION_READBACK_DAILY_LIMIT=1000
PUBLICATION_READBACK_MAX_ACTIVE=2
# 仅主服务保存每节点的 HMAC ID -> 独立密钥 JSON 映射；不要提交真实密钥。
PUBLICATION_READBACK_NODE_KEYS_JSON={}
GENERATION_WORKER_RATE_LIMIT=10
# Worker 每 15 秒续租；租约 120 秒。心跳间隔必须小于租约时长的一半。
GENERATION_HEARTBEAT_INTERVAL_MS=15000
GENERATION_LEASE_DURATION_MS=120000
GENERATION_RECONCILE_INTERVAL_MS=60000
# Provider 连续运行失败 5 次后熔断 60 秒，冷却后仅放行一个半开探针。
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_COOLDOWN_MS=60000
PROVIDER_CIRCUIT_PROBE_LEASE_MS=120000

# 平台托管模型 API Key 使用 AES-256-GCM 加密。生产环境必须使用独立随机 32 字节 Base64 Key。
# 生成示例：openssl rand -base64 32
MODEL_CREDENTIAL_ENCRYPTION_KEY=
MODEL_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
# Generate an independent random credential for the one-time /setup wizard.
INSTALLATION_TOKEN=

# 本机 Docker: dev-postgresql
DATABASE_URL=postgresql://dev_xhs_agentic:dev_xhs_agentic_password@127.0.0.1:5432/dev_xhs_agentic?schema=public&options=-c%20timezone%3DUTC
SHADOW_DATABASE_URL=postgresql://dev_xhs_agentic:dev_xhs_agentic_password@127.0.0.1:5432/dev_xhs_agentic_shadow?schema=public&options=-c%20timezone%3DUTC

# 本机 Docker: dev-redis；所有项目 Key 必须使用此前缀
REDIS_URL=redis://dev_xhs_agentic:dev_xhs_agentic_password@127.0.0.1:6379/0
REDIS_PREFIX=xhs-agentic:dev

# LOCAL / S3；未设置时兼容旧 S3 配置。LOCAL 时 API/Worker 必须使用同一绝对目录。
OBJECT_STORAGE_PROVIDER=S3
OBJECT_STORAGE_LOCAL_ROOT=
# S3 模式才使用以下兼容 API 配置；本机存储不需要额外对象存储服务。
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=dev-xhs-agentic
OBJECT_STORAGE_ACCESS_KEY=dev_xhs_agentic
OBJECT_STORAGE_SECRET_KEY=dev_xhs_agentic_password
OBJECT_STORAGE_FORCE_PATH_STYLE=true
ASSET_DELIVERY_MODE=S3_SIGNED
ASSET_DELIVERY_BASE_URL=
ASSET_DELIVERY_SIGNING_KEY=
# 开发默认关闭。生产在平台「参数设置 → 内容安全」选择模型并通过图文测试。
# MODEL 模式复用已保存的模型供应商与加密凭据；下列 Provider/Endpoint/Key 仅用于独立 HTTP 审核服务。
CONTENT_SAFETY_MODE=DISABLED
CONTENT_SAFETY_PROVIDER=
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_API_KEY=
CONTENT_SAFETY_TIMEOUT_MS=30000

# 真实 Provider 验收变量默认不配置，也不得提交真实 Key。
# PILOT_BENCHMARK_BASE_URL=https://provider.example/v1
# PILOT_BENCHMARK_API_KEY=replace-with-a-dedicated-benchmark-key
# PILOT_BENCHMARK_PROVIDER_ID=provider-code
# PILOT_BENCHMARK_TEXT_MODEL=text-model-id
# PILOT_BENCHMARK_IMAGE_MODEL=image-model-id
# PILOT_BENCHMARK_INPUT_COST=1.25
# PILOT_BENCHMARK_OUTPUT_COST=5
# PILOT_BENCHMARK_IMAGE_COST=0.12
# PILOT_BENCHMARK_COST_CURRENCY=CNY
# PILOT_BENCHMARK_CONCURRENCY=2
# PILOT_BENCHMARK_TIMEOUT_MS=120000
